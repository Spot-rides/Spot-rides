DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=spot_rides
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SIGNING_KEY=change-me-distinct-from-secret-key

# OTP
OTP_PEPPER=change-me-32-bytes-base64
OTP_DEV_MODE=False
OTP_DEV_FIXED_CODE=000000
OTP_COUNTRY_ALLOWLIST=IN

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# DL Verification (profiles app)
# Generate DL_ENCRYPTION_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DL_ENCRYPTION_KEY=PLACEHOLDER_KEY_REPLACE_WITH_FERNET_KEY
DL_WEBHOOK_SECRET=PLACEHOLDER_SECRET_REPLACE_WITH_RANDOM_STRING

# Onboarding gate (set to true once frontend is deployed)
ONBOARDING_GATE_ENABLED=false

RC_VERIFICATION_ENABLED=False
RC_ADAPTER_CLASS=profiles.adapters.mock.MockRCVerificationAdapter
RC_ADAPTER_MOCK_RESULT=sync_verified
RC_PROVIDER_TIMEOUT_SECONDS=5
RC_MAX_ATTEMPTS=3
RC_WEBHOOK_SECRET=PLACEHOLDER_SECRET_REPLACE_WITH_RANDOM_STRING